<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Merged into the target's generated Info.plist (GENERATE_INFOPLIST_FILE = YES, INFOPLIST_FILE
	pointing here) — this file carries only what the generator has no build setting for.

	The row drag's payload needs a content type this app owns, rather than the abstract system
	type `public.content`: see the doc comment on `UTType.draggedCommitmentRow` in
	CommitmentsView.swift for why, and Apple's "Defining File and Data Types for Your App" for
	the identifier and Info.plist shape this follows.
	-->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.dbugmann.daybyday.dragged-commitment-row</string>
			<key>UTTypeDescription</key>
			<string>A commitment row being dragged to reorder it</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.content</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
